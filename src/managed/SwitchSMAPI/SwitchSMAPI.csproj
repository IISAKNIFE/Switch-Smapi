<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SwitchSMAPI</AssemblyName>
    <RootNamespace>SwitchSMAPI</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\SwitchSMAPI.xml</DocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Stardew Valley Modding API port for Nintendo Switch (Atmosphere CFW)</Description>
    <Authors>Switch-SMAPI Contributors</Authors>
    <Copyright>Copyright (c) 2024 Switch-SMAPI Contributors</Copyright>
    <!-- Copy NuGet dependencies (Newtonsoft.Json, Microsoft.CSharp) next to SwitchSMAPI.dll
         so tools/package_mod.py can find them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony"       Version="2.3.3" />
    <PackageReference Include="Newtonsoft.Json"   Version="13.0.3" />
    <PackageReference Include="Microsoft.CSharp"  Version="4.7.0" />
  </ItemGroup>

  <!-- CI / no-dump fallback: compile-only MonoGame reference so Microsoft.Xna.* types resolve.
       Never shipped; at runtime the game's own MonoGame.Framework.dll is used. -->
  <ItemGroup Condition="'$(StardewSwitchDump)' == ''">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641"
                      PrivateAssets="all" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <!-- These references point at legal game dump assemblies.
       Set $(StardewSwitchDump) to the folder containing them. -->
  <ItemGroup Condition="'$(StardewSwitchDump)' != ''">
    <Reference Include="Stardew Valley">
      <HintPath>$(StardewSwitchDump)\Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(StardewSwitchDump)\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(StardewSwitchDump)\xTile.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- A netstandard2.0 build only sees Harmony's reference assembly, so copy the real
       runtime 0Harmony.dll (a .NET Framework build, which Mono can load) from the package. -->
  <Target Name="CopyHarmonyRuntime" AfterTargets="Build">
    <PropertyGroup>
      <_HarmonyLibDir>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))lib.harmony/2.3.3/lib/</_HarmonyLibDir>
      <_HarmonyDll Condition="Exists('$(_HarmonyLibDir)net472/0Harmony.dll')">$(_HarmonyLibDir)net472/0Harmony.dll</_HarmonyDll>
      <_HarmonyDll Condition="'$(_HarmonyDll)' == '' And Exists('$(_HarmonyLibDir)net48/0Harmony.dll')">$(_HarmonyLibDir)net48/0Harmony.dll</_HarmonyDll>
      <_HarmonyDll Condition="'$(_HarmonyDll)' == '' And Exists('$(_HarmonyLibDir)net452/0Harmony.dll')">$(_HarmonyLibDir)net452/0Harmony.dll</_HarmonyDll>
    </PropertyGroup>
    <Copy Condition="'$(_HarmonyDll)' != ''" SourceFiles="$(_HarmonyDll)" DestinationFolder="$(OutDir)" />
    <Warning Condition="'$(_HarmonyDll)' == ''" Text="Could not find a runtime 0Harmony.dll under $(_HarmonyLibDir)" />
  </Target>

</Project>
